# Sao chép tệp này vào .env (cho tất cả các chế độ) hoặc .env.development / .env.production nếu cần
# Chỉ các biến có tiền tố VITE_ mới được hiển thị ở client.


VITE_API_BASE_URL=http://localhost:8000
VITE_TURN_SERVER_URL=turn:relay1.expressturn.com:3480
VITE_TURN_SERVER_USERNAME=your_username
VITE_TURN_SERVER_CREDENTIAL=your_password
